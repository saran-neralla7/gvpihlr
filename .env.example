# =========================================================================
# GVPIHLR ERP Environment Variables Template
# =========================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gvpihlr_erp?schema=public"

# Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"

# Optional Rate Limiting / Redis Configuration
REDIS_URL="redis://localhost:6379"

# Institutional Backup (Google Drive integration)
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""

# SMS Gateway (Parent Alerts)
SMS_API_KEY=""
SMS_API_URL=""

# Encryption Key for sensitive fields (AES-256)
ENCRYPTION_KEY="CHANGE_THIS_TO_A_32_BYTE_HEX_OR_BASE64_KEY"
